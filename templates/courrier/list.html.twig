{% extends 'base.html.twig' %}

{% block title %}Liste des courriers - GECAT{% endblock %}

{% block body %}
    <!-- Breadcrumb -->
    <div class="breadcrumb-custom">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Tableau de bord</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Liste des courriers</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Contenu principal -->
    <div class="main-content">
        <div class="container">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success mt-3">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger mt-3">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('warning') %}
                <div class="alert alert-warning mt-3">{{ message }}</div>
            {% endfor %}

            <!-- En-tête de page -->
            <div class="page-header">
                <h2 class="page-title">Liste des courriers</h2>
                <a href="{{ path('app_courrier_new') }}" class="btn btn-nouveau">
                    <i class="bi bi-plus-lg"></i>
                    Nouveau courrier
                </a>
            </div>

            <!-- Tableau des courriers -->
            <div class="table-container">
                <table class="custom-table">
                    <thead>
                    <tr>
                        <th>Référence</th>
                        <th>Objet</th>
                        <th>Statut</th>
                        <th>Destinataire</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% if courriers is empty %}
                        <tr>
                            <td colspan="5" class="text-center p-4">Aucun courrier enregistré pour le moment.</td>
                        </tr>
                    {% else %}
                        {% for courrier in courriers %}
                            <tr>
                                <td>{{ courrier.reference }}</td>
                                <td>{{ courrier.objet }}</td>
                                <td><span class="badge-{{ courrier.statut }}">{{ courrier.statut|replace({'_': ' '})|capitalize }}</span></td>
                                <td>{{ courrier.destinataire }}</td>
                                <td>
                                    <a href="{{ path('app_courrier_show', {'id': courrier.id}) }}" class="btn btn-action btn-voir">
                                        <i class="bi bi-eye-fill"></i>
                                        Voir
                                    </a>
                                    <form method="post" action="{{ path('app_courrier_delete', {'id': courrier.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce courrier ?');" style="display:inline-block;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ courrier.id) }}">
                                        <button class="btn btn-action btn-supprimer">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                    </tbody>
                </table>

                <!-- Pagination (à dynamiser plus tard) -->
                {#
                <nav>
                    <ul class="pagination">
                        {% for p in 1..totalPages %}
                            <li class="page-item {{ p == page ? 'active' }}">
                                <a class="page-link" href="{{ path('app_courrier_list', { page: p }) }}">
                                    {{ p }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
                <div class="pagination-container m-3">
                    <div class="pagination-info">
                        Affichage de 1 à {{ courriers|length }} sur {{ courriers|length }} courriers
                    </div>
                </div>
                #}

                {# Pagination #}
                <nav class="d-flex justify-content-center">
                    <ul class="pagination">
                        {# Bouton précédent #}
                        <li class="page-item {{ page == 1 ? 'disabled' }}">
                            <a class="page-link"
                               href="{{ path('app_courrier_list', { page: page - 1 }) }}">
                                Précédent
                            </a>
                        </li>

                        {% for p in 1..totalPages %}
                            <li class="page-item {{ p == page ? 'active' }}">
                                <a class="page-link"
                                   href="{{ path('app_courrier_list', { page: p }) }}">
                                    {{ p }}
                                </a>
                            </li>
                        {% endfor %}

                        {# Bouton suivant #}
                        <li class="page-item {{ page == totalPages ? 'disabled' }}">
                            <a class="page-link"
                               href="{{ path('app_courrier_list', { page: page + 1 }) }}">
                                Suivant
                            </a>
                        </li>
                    </ul>
                </nav>

                {# Texte d’information pagination #}
                <div class="text-center text-muted mt-2">
                    Affichage de
                    {{ (page - 1) * limit + 1 }}
                    à
                    {{ (page - 1) * limit + courriers|length }}
                    sur
                    {{ totalItems }}
                    courriers
                </div>
            </div>
        </div>
    </div>
{% endblock %}
