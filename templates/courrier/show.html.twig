{% extends 'base.html.twig' %}

{% block title %}Courrier {{ courrier.reference }} - GECAT{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/show.css') }}">
{% endblock %}

{% block body %}
    <!-- Breadcrumb -->
    <div class="breadcrumb-custom">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Tableau de bord</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_courrier_list') }}">Liste des courriers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{ courrier.reference }}</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Contenu principal -->
    <div class="main-content">
        <div class="container">
            <!-- Flash messages -->
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            <!-- En-tête de page -->
            <div class="page-header">
                <div>
                    <h2 class="page-title">Détail du courrier</h2>
                    <p class="page-subtitle">Consultation des informations du courrier</p>
                </div>
                <div class="btn-group-actions">
                    <a href="{{ path('app_courrier_list') }}" class="btn-action btn-retour">
                        <i class="bi bi-arrow-left"></i>
                        Retour
                    </a>
                    <a href="{{ path('app_courrier_pdf', {'id': courrier.id}) }}" class="btn-action btn-pdf" target="_blank">
                        <i class="bi bi-file-earmark-pdf"></i>
                        Télécharger le PDF
                    </a>
                    <a href="{{ path('app_courrier_edit', {'id': courrier.id}) }}" class="btn-action btn-modifier">
                        <i class="bi bi-pencil-fill"></i>
                        Modifier
                    </a>
                    <form method="post" action="{{ path('app_courrier_delete', {'id': courrier.id}) }}" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ courrier.id) }}">
                        <button type="submit" class="btn-action btn-supprimer" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce courrier ?')">
                            <i class="bi bi-trash-fill"></i>
                            Supprimer
                        </button>
                    </form>
                </div>
            </div>

            <!-- Contenu du courrier -->
            <div class="courrier-container">
                <!-- En-tête du courrier -->
                <div class="courrier-header">
                    <div class="courrier-reference">
                        <i class="bi bi-hash"></i>
                        Référence : <span class="courrier-reference-number">{{ courrier.reference }}</span>
                    </div>
                    <h1 class="courrier-objet">{{ courrier.objet }}</h1>

                    <!-- Badge de statut -->
                    {% if courrier.statut == 'entrant' %}
                        <span class="status-badge status-entrant">
                            <i class="bi bi-arrow-down-circle-fill"></i>
                            Courrier entrant
                        </span>
                    {% elseif courrier.statut == 'sortant' %}
                        <span class="status-badge status-sortant">
                            <i class="bi bi-arrow-up-circle-fill"></i>
                            Courrier sortant
                        </span>
                    {% else %}
                        <span class="status-badge status-interne">
                            <i class="bi bi-arrow-left-right"></i>
                            Courrier interne
                        </span>
                    {% endif %}
                </div>

                <!-- Grille de détails -->
                <div class="details-grid">
                    <!-- Expéditeur -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-person-fill"></i>
                            Expéditeur
                        </div>
                        <div class="detail-value">
                            {{ courrier.expediteur ?: '—' }}
                        </div>
                    </div>

                    <!-- Destinataire -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-building"></i>
                            Destinataire
                        </div>
                        <div class="detail-value">
                            {{ courrier.destinataire ?: '—' }}
                        </div>
                    </div>

                    <!-- Date de réception -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-calendar-check"></i>
                            Date de réception
                        </div>
                        <div class="detail-value">
                            {{ courrier.dateReception|date('d/m/Y à H:i') }}
                        </div>
                    </div>

                    <!-- Nature -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-tag-fill"></i>
                            Nature
                        </div>
                        <div class="detail-value">
                            {{ courrier.nature ? courrier.nature|replace({'-': ' '})|capitalize : '—' }}
                        </div>
                    </div>

                    <!-- Gestionnaire -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-person-badge"></i>
                            Gestionnaire
                        </div>
                        <div class="detail-value">
                            {{ courrier.gestionnaire ?: '—' }}
                        </div>
                    </div>

                    <!-- Responsable administratif -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-person-check-fill"></i>
                            Responsable administratif
                        </div>
                        <div class="detail-value">
                            {{ courrier.responsable ?: '—' }}
                        </div>
                    </div>
                </div>

                <!-- Section contenu -->
                <div class="content-section">
                    <div class="content-label">
                        <i class="bi bi-file-text-fill"></i>
                        Contenu du courrier
                    </div>
                    {% if courrier.contenu %}
                        <div class="content-text">{{ courrier.contenu|nl2br }}</div>
                    {% else %}
                        <div class="content-empty">
                            <i class="bi bi-file-earmark-x"></i>
                            Aucun contenu détaillé pour ce courrier.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
