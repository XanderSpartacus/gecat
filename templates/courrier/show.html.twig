{% extends 'base.html.twig' %}

{% block body %}
    {#
    <pre>
    {{ dump(courrier) }}
    </pre>
    -id: 3602398
    -reference: "2026-1021-735"
    -objet: "Bon de commande équipements informatiques"
    -contenu: "Veuillez trouver ci-joint le document relatif à la demande."
    -dateReception: DateTimeImmutable @1798070400 {#705 ▶}
    -statut: "entrant"
    -expediteur: "Trésor Public du Gabon"
    -destinataire: "Direction Générale"
    -nature: "Bon de commande"
    -gestionnaire: "Aziza Moumbaga"
    -responsable: "Mme Marie Obame – Directrice Financière"
    #}

<div class="main-content">
    <div class="container">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mt-3">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger mt-3">{{ message }}</div>
        {% endfor %}

        <h1>Détail du Courrier <small class="text-muted">#{{ courrier.id }}</small></h1>

        <div class="card">
            <div class="card-header">
                Référence : <strong>{{ courrier.reference }}</strong>
            </div>

            <div class="card-body">
                <h5 class="card-title">{{ courrier.objet }}</h5>
                <h6 class="card-subtitle mb-2 text-muted">Statut : {{ courrier.statut }}</h6>
                <p class="card-text">
                    <strong>Expéditeur :</strong> {{ courrier.expediteur }} <br>
                    <strong>Destinataire :</strong> {{ courrier.destinataire }} <br>
                    <strong>Date de réception :</strong> {{ courrier.dateReception|date('d/m/Y H:i') }}
                </p>
                {% if courrier.contenu %}
                    <p class="card-text border p-3 bg-light">{{ courrier.contenu|nl2br }}</p>
                {% else %}
                    <p class="card-text text-muted">Aucun contenu détaillé pour ce courrier.</p>
                {% endif %}
                <a href="{{ path('app_courrier_list') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
                <a href="{{ path('app_courrier_edit', {'id': courrier.id}) }}" class="btn btn-warning mt-3">Modifier</a>
                <form method="post" action="{{ path('app_courrier_delete', {'id': courrier.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce courrier ?');" style="display:inline-block;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ courrier.id) }}">
                    <button class="btn btn-danger mt-3">Supprimer</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

