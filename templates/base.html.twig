<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon" href="{{ asset('images/logo.png') }}">
    {# Bootstrap Icons #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>

{# Affiche les messages flash uniquement si on se trouve sur la page login #}
{% if app.request.attributes.get('_route') == 'app_login' %}
    {% set success = app.flashes('success') %}
    {% set error = app.flashes('error') %}
    {% set warning = app.flashes('warning') %}

    {% if success or error or warning %}
        <div class="container mt-3">
            {% for message in success %}
                <div class="alert alert-success" role="alert">{{ message }}</div>
            {% endfor %}
            {% for message in error %}
                <div class="alert alert-danger" role="alert">{{ message }}</div>
            {% endfor %}
            {% for message in warning %}
                <div class="alert alert-warning" role="alert">{{ message }}</div>
            {% endfor %}
        </div>
    {% endif %}
{% endif %}

{% if app.user %}
    <!-- Header -->
    <div class="header">
        <div class="container">
            <div class="header-content">
                <img src="{{ asset('images/logo.png') }}" alt="GECAT Logo">
                <div class="header-title">
                    <h1>GECAT</h1>
                    <p>Gestion Électronique du Courrier Administratif du Trésor</p>
                </div>
            </div>
        </div>
    </div>
    {% include '_partials/_navbar.html.twig' %}
{% endif %}
{% block body %}{% endblock %}
</body>
</html>
