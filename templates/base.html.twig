<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon" href="{{ asset('images/logo.png') }}">
    {# Bootstrap Icons #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
{% if app.user %}
    <!-- Header -->
    <div class="header">
        <div class="container">
            <div class="header-content">
                <img src="{{ asset('images/logo.png') }}" alt="GECAT Logo">
                <div class="header-title">
                    <h1>GECAT</h1>
                    <p>Gestion Électronique du Courrier Administratif du Trésor</p>
                </div>
            </div>
        </div>
    </div>
    {% include '_partials/_navbar.html.twig' %}
{% endif %}
{% block body %}{% endblock %}
</body>
</html>
